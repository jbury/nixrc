[include]
	path = ${XDG_CONFIG_HOME}/git/default-user.ini
[includeIf "gitdir:~/.nixrc"]
	path = ${XDG_CONFIG_HOME}/git/personal-user.ini
[includeIf "gitdir:~/workspace/personal/"]
	path = ${XDG_CONFIG_HOME}/git/personal-user.ini
[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/
	insteadOf = gitlab.com/
[url "git@github.com:"]
	insteadOf = https://github.com/
	insteadOf = github.com/
[init]
	defaultBranch = main
[branch]
	sort = -comitterdate
[commit]
	gpgSign = true
[tag]
	sort = -version:refname
        gpgSign = true
[advice]
	skippedCherryPicks = false
[fetch]
	prune = true
	pruneTags = true
[rebase]
	autoSquash = true
	autoStash = true
[push]
	default = current
	autoSetupRemote = true
[pull]
	rebase = true
	twohead = ort
[rerere]
	enabled = true
	autoupdate = 1
[column]
	ui = auto
[diff]
	algorithm = histogram
[diff "org"]
	xfuncname = "^(\\*+ +.*)$"
[alias]
	uncommit = "reset --soft HEAD~1"
	restore-file = "checkout HEAD --"
	get = "!f() { git clone -v git@github.com:jbury/$1; }; f"
	outta-here = "!echo https://www.youtube.com/watch?v=BHkfdZjshqY&t=34s"
	gud = "!cat ${XDG_CONFIG_HOME}/git/dad.txt"
[protocol]
	version = 2
[filter "tabspace2"]
	smudge = unexpand --tabs=2 --first-only
	clean = expand --tabs=2 --initial
[filter "tabspace4"]
	smudge = unexpand --tabs=4 --first-only
	clean = expand --tabs=4 --initial
